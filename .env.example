# ========== DATABASE ==========
POSTGRES_USER=dify
POSTGRES_PASSWORD=change_me_secure_password_here_12345
POSTGRES_DB=dify
POSTGRES_PORT=5432

# ========== REDIS ==========
REDIS_PASSWORD=change_me_redis_password_here_12345
REDIS_PORT=6379

# ========== SECURITY ==========
SECRET_KEY=change_me_to_a_random_secure_key_min_32_chars_12345678901234567890

# ========== PLUGIN DAEMON ==========
# Deben coincidir entre dify-api y plugin-daemon (ver docker-compose.yml).
PLUGIN_DAEMON_KEY=change_me_plugin_daemon_key_min_32_chars_1234567890
PLUGIN_DIFY_INNER_API_KEY=change_me_plugin_inner_api_key_min_32_chars_1234567890
# Verifica la firma de los plugins instalados. Los del marketplace oficial
# vienen firmados; poné esto en false solo para instalar plugins locales/
# no firmados durante desarrollo.
PLUGIN_FORCE_VERIFYING_SIGNATURE=true

# ========== API KEYS ==========
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== EMAIL ==========
MAIL_TYPE=smtp
SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_DEFAULT_SEND_FROM=noreply@cobreloa.cl

# ========== URLS ==========
# Usadas por dify-api para construir links salientes absolutos (invitaciones,
# reset de password, callbacks OAuth) y para el CORS del servidor Socket.IO
# (colaboración en tiempo real del editor de workflows — sin esto el editor
# queda trabado en "Syncing data", ver docs/TROUBLESHOOTING.md). Deben ser
# la URL pública real por la que los usuarios acceden (en local, vía nginx:
# http://localhost — no :3000/:5001 directo; en producción, el dominio
# real, ej. https://socios.cobreloa.cl). Las 5 deben mantenerse en sync.
CONSOLE_WEB_URL=http://localhost
CONSOLE_API_URL=http://localhost
SERVICE_API_URL=http://localhost
APP_WEB_URL=http://localhost
CONSOLE_CORS_ALLOW_ORIGINS=http://localhost

# ========== PUERTOS ==========
# dify-web (3000) a propósito no tiene puerto publicado — solo se accede
# vía nginx (puerto 80). Ver docs/TROUBLESHOOTING.md.
DIFY_API_PORT=5001

# ========== STORAGE ==========
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data

# ========== LOGGING ==========
LOG_LEVEL=INFO
